# ==== GitHub App 基础配置（注册 App 后获取）====
# App ID：GitHub App 设置页面顶部
APP_ID=
# Webhook secret：注册时你填写的随机串
WEBHOOK_SECRET=
# Private key：注册时生成的 .pem 内容
# 如果 .env 里不便换行，把换行写成 \n（代码里会自动还原）
PRIVATE_KEY=

# ==== AI 提供方：anthropic | openai | gemini ====
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OpenAI 兼容端点（本地模型如 Ollama / vLLM）
# OPENAI_BASE_URL=http://localhost:11434/v1

# ==== 可选配置 ====
# 覆盖默认模型
# AI_MODEL=claude-sonnet-4-5-20250929
# AI_MODEL=gpt-4o
# 限制发送给 AI 的 diff 最大字符数（防止超大 PR 超出上下文）
MAX_DIFF_LENGTH=40000
